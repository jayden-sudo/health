{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Health",
  "version": "0.1.0",
  "identifier": "app.health.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Health",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/health"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Your health data, on your computer",
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "lproj/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "lproj/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "lproj/zh-Hant.lproj/InfoPlist.strings"
      }
    }
  }
}
